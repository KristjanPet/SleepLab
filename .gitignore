# ==========================================
# SleepLab - .gitignore
# STM32CubeMX / STM32 HAL / CMake / Ninja / VS Code
# ==========================================

# Build output and compiled firmware
/build/
/build-*/
/cmake-build-*/
/out/
/Debug/
/Release/
*.o
*.obj
*.a
*.lib
*.elf
*.bin
*.hex
*.map
*.lst
*.d
*.su
*.gcda
*.gcno
*.gcov

# Generated CMake / Ninja files
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
cmake_install.cmake
compile_commands.json
Makefile
Testing/
.ninja_deps
.ninja_log
build.ninja

# Local IDE and editor settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.vscode/c_cpp_properties.json
.idea/
*.code-workspace

# STM32CubeMX / STM32CubeIDE local workspace metadata
.metadata/
.settings/
.mxproject
.project
.cproject
.externalToolBuilders/
.stm32cubeide/

# Local compiler wrappers (not portable across machines)
cmake/host-tools/

# Temporary, backup, and OS files
*.swp
*.swo
*~
*.tmp
*.bak
*.orig
*.log
.DS_Store
Thumbs.db

# Crash dumps (do NOT use *core*: CMSIS needs core_cm4.h!)
/core.*
*.core

# Python helper scripts: generated files only
__pycache__/
*.pyc
.venv/
venv/

# IMPORTANT: Keep the following files tracked:
#   Drivers/CMSIS/ (including core_cm4.h)
#   Drivers/STM32F4xx_HAL_Driver/
#   Core/
#   SleepLab.ioc
#   CMakeLists.txt and CMakePresets.json
